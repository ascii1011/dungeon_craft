# gdtoolkit linting configuration for DungeonCraft
# See: https://github.com/Scony/godot-gdscript-toolkit

rules:
  # Line length: raise limit to 120 (default is 100)
  max-line-length: 120

  # Allow underscore-prefixed names for private variables and functions.
  # This is idiomatic GDScript convention (e.g. _ready, _private_var).
  private-method-call: false
